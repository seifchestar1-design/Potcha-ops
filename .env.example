# Local development uses SQLite (the file is created by `bun run db:push`).
DATABASE_URL="file:db/custom.db"

# Production (Vercel / VPS / Docker): use a PostgreSQL connection string instead —
# see docs/DEPLOYMENT.md and docs/SUPABASE_SETUP.md.
#
# Cloudflare Workers: no DATABASE_URL needed — the connection comes from the
# HYPERDRIVE binding. See docs/CLOUDFLARE.md.
